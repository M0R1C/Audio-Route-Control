<Window x:Class="AudioRouteControl.TrayMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="325" Height="433" MinHeight="183" MaxHeight="567"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" ShowActivated="True">
    <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource WindowStrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <StackPanel x:Name="SourcesPanel" />
            </ScrollViewer>
            <Button Grid.Row="1" Content="Открыть настройки" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsButton_Click" />
        </Grid>
    </Border>
</Window>
